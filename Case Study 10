7. Python Source Code
v = float(input("Venue cost: "))
e = float(input("Equipment cost: "))
c = float(input("Catering cost: "))
t = float(input("Transport cost: "))
s = float(input("Sponsorship: "))
fee = float(input("Contribution per participant: "))
total = v + e + c + t
shortfall = max(0, total - s)
print("Total Cost:", total)
print("Shortfall:", shortfall)
print("Participants Needed:", int(shortfall / fee) + (shortfall % fee > 0))

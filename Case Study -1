6.  Pseudocode
START
INPUT n
total = 0
REPEAT n times:
  INPUT vehicle, offence, repeat
  Set fine using the fine table
  IF repeat = yes: fine = fine * 2
  total = total + fine
IF n >= 3: print review required
ELSE: print no review flag
PRINT total
STOP

7.Python Source Code
fines = {"helmet": 500, "signal": 1000, "speeding": 1500}
n = int(input("Number of violations: "))
total = 0

for i in range(n):
    vehicle = input("Vehicle: ")
    offence = input("Offence: ").lower()
    repeat = input("Repeat? yes/no: ").lower()
    fine = fines[offence]
    if repeat == "yes":
        fine = fine * 2
    total = total + fine
    print(vehicle, "fine =", fine)

print("Total penalty:", total)
if n >= 3:
    print("Review required")
else:
    print("No review flag")

